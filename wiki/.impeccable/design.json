      "html": "<div class=\"ds-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"Partner comparison\"><table class=\"ds-table\"><thead><tr><th>Partner</th><th aria-sort=\"none\"><button type=\"button\" class=\"ds-sort\">HP<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m8 8 4-4 4 4m-8 8 4 4 4-4\"/></svg></button></th></tr></thead><tbody><tr><td>Charmander</td><td>88</td></tr><tr><td>Bulbasaur</td><td>104</td></tr></tbody></table></div>",
