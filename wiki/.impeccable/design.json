  "narrative": {
    "northStar": "The Trainer Expedition Handbook",
    "overview": "Forest-night framing, gold actions and warm paper give the Wiki a game identity while leaving reference content calm and readable. Pixelify identifies the world; plain sans-serif text carries explanations, controls and data. The original Rift Guardian mark anchors the independent Wiki identity.\n\nDensity follows the task: ruled lists and real tables support quick comparison, while tools gather related controls into a distinct forest panel. Elemental colors accompany written types. This system is extracted from the implemented stylesheet and desktop/mobile renders after the authorized redesign.",
    "keyCharacteristics": [
      "Forest-night frame with gold actions and warm reading surfaces.",
      "Pixel identity paired with readable reference typography.",
      "Native controls, useful source-backed previews and real tables."
    ],
    "rules": [
      {
        "name": "The Contextual Action Rule",
        "body": "Use gold actions on the forest opening and forest actions on paper; preserve their context-specific text and focus colors.",
        "section": "colors"
      },
      {
        "name": "The Two Reading Speeds Rule",
        "body": "Pixelify carries identity and selected numeric highlights; Arial carries long explanations and comparison data.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the forest-night frame, gold opening actions and calm paper reading surfaces.",
      "Do keep Pixelify for identity and selected highlights, and Arial for readable reference text.",
      "Do preserve native controls, visible focus, written type labels and bounded table scrolling.",
      "Do retain the Rift Guardian master and provenance on its derived icon exports.",
      "Do keep mobile navigation clear of device safe areas and reserve space below the document."
    ],
    "donts": [
      "Don't replace native radio selection, sortable header buttons or disclosures with decorative controls.",
      "Don't conceal navigation or the initial partner reference when JavaScript is unavailable.",
      "Don't add repeated motion to reading surfaces or animate when reduced motion is requested.",
      "Don't invent gameplay evidence or substitute third-party character art for the original mark."
    ]
  }
}
